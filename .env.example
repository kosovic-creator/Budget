# Use the pooled Neon URL for application requests.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require"

# Optional direct Neon URL for Prisma schema commands.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="12345678901234567890123456789012"

# Local development URL. In production use the final HTTPS domain.
BETTER_AUTH_URL="https://budget-smoky-nine.vercel.app/"
