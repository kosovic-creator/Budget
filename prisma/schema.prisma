generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum Category {
  PERSONAL
  HOUSEHOLD
  SALARY
  OTHER
}

model Transaction {
  id        String          @id @default(cuid())
  title     String
  amount    Decimal         @db.Decimal(12, 2)
  type      TransactionType
  category  Category
  date      DateTime        @default(now())
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model BudgetSettings {
 id String @id @default("default")
 household Decimal @default(0) @db.Decimal(12, 2)
 personal Decimal @default(0) @db.Decimal(12, 2)
 other Decimal @default(0) @db.Decimal(12, 2)
 cash Decimal @default(0) @db.Decimal(12, 2)
}
